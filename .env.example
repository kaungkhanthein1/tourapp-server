# Neon PostgreSQL connection string (use the pooler endpoint)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# HTTP server port
PORT=8080

# Gin mode: debug | release | test
GIN_MODE=release

# JWT signing secret (min 16 chars; generate: openssl rand -hex 32)
JWT_SECRET=

# Comma-separated allowed origins, or * for all (mobile clients)
CORS_ALLOWED_ORIGINS=*

# Optional hybrid-fallback providers (leave empty to disable fallback)
GOOGLE_PLACES_API_KEY=
MAKCORPS_API_KEY=

# Optional override for the seed JSON directory
MOCK_DATA_DIR=mock_data
