# Neon PostgreSQL connection string (use the pooler endpoint)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# HTTP server port
PORT=8080

# Gin mode: debug | release | test
GIN_MODE=release

# JWT signing secret (min 16 chars; generate: openssl rand -hex 32)
JWT_SECRET=

# Comma-separated allowed origins, or * for all (mobile clients)
CORS_ALLOWED_ORIGINS=*

# SerpApi plan key — bootstrap-only (`go run ./cmd/bootstrap -serpapi`):
# Google Maps/Hotels seeding, one plan credit per query (~250/month).
# The running server never calls SerpApi; without the flag this is unused.
SERPAPI_KEY=

# Optional override for the seed JSON directory
MOCK_DATA_DIR=mock_data
